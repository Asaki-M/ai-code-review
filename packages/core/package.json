{
  "name": "@ai-code-review/core",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/agents/reviewAgent/skills && cp src/agents/reviewAgent/skills/*.md dist/agents/reviewAgent/skills/",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.46",
    "@langchain/google-vertexai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@opencode-ai/sdk": "^1.15.4",
    "langchain": "^1.4.0",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  }
}